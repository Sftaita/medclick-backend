# Modèle du .env de /opt/stack/apps/medclick-prod (chmod 600, jamais versionné).
# Secrets générés sur le VPS (openssl rand -hex 32), sauf MAILER_DSN et ERROR_ALERT_EMAIL, repris
# du .env Hostinger par copie directe serveur à serveur (jamais affichés ni copiés sur le poste).

# Origines des fronts autorisées (identiques à la production Hostinger, HTTPS seulement).
CORS_ALLOW_ORIGIN=^https://(admin\.easymed\.fun|api-medclick\.easymed\.fun|frontend\.easymed\.fun|medclick\.be|www\.medclick\.be)$

DB_NAME=medclick_prod
DB_USER=medclick_prod
DB_PASSWORD=
DB_ROOT_PASSWORD=

APP_SECRET=
# Clés JWT propres au VPS (les jetons Hostinger en cours deviennent invalides : reconnexion).
JWT_PASSPHRASE=

MAILER_DSN=
ERROR_ALERT_EMAIL=

# false pendant la bascule A ; true pour la bascule B (www.medclick.be et medclick.be → VPS).
WWW_LIVE=false
