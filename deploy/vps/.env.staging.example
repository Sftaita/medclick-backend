# Modèle du .env de /opt/stack/apps/medclick-staging (chmod 600, jamais versionné).
# Générer les secrets sur le VPS, par ex. : openssl rand -hex 32

PUBLIC_HOST=staging.medclick.be
PUBLIC_URL=https://staging.medclick.be
CORS_ALLOW_ORIGIN=^https://staging\.medclick\.be$

DB_NAME=medclick_staging
DB_USER=medclick_staging
DB_PASSWORD=
DB_ROOT_PASSWORD=

APP_SECRET=
# Phrase de passe des clés JWT de CET environnement (jamais celle de la production).
JWT_PASSPHRASE=

# BACKEND_TAG, FRONTEND_TAG : enregistrées par deploy.sh à chaque déploiement (ne pas renseigner).

# Destinataire des alertes techniques : erreurs (ERROR_ALERT_EMAIL) et exports Excel
# (EXPORT_ALERT_EMAIL, par défaut ERROR_ALERT_EMAIL). Capturées par Mailpit en préproduction. Vide = aucune.
ERROR_ALERT_EMAIL=
EXPORT_ALERT_EMAIL=
