# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
SYMFONY_DEPRECATIONS_HELPER=999999
PANTHER_APP_ENV=panther

# Base SQLite jetable : le schéma est recréé par les tests (tests/ApiTestBase.php).
DATABASE_URL="sqlite:///%kernel.project_dir%/var/test.db"
MAILER_DSN=null://null

# Exports asynchrones : dossier propre aux tests, alertes envoyées (transport mailer nul).
EXPORT_STORAGE_DIR=%kernel.project_dir%/var/exports-test
EXPORT_ALERT_EMAIL=admin.alertes@example.test
