# Modèle de configuration — AUCUN SECRET ICI.
#
# Installation locale : copier ce fichier en ".env" (non versionné) puis renseigner les valeurs.
# En production, préférer les variables d'environnement de l'hébergeur ou "bin/console secrets:set".

###> symfony/framework-bundle ###
APP_ENV=dev
APP_DEBUG=true
APP_SECRET=change-me
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Préciser serverVersion (ex. mariadb-11.3.2 ou 8.0) : évite une connexion à la base au démarrage.
DATABASE_URL="mysql://root:@127.0.0.1:3306/medclick?serverVersion=8.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> lexik/jwt-authentication-bundle ###
# Clés générées par : php bin/console lexik:jwt:generate-keypair
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=change-me
###< lexik/jwt-authentication-bundle ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

###> URL de l'api ###
API_URL="'http://localhost:8000/api/'"
###< URL de l'api ###
